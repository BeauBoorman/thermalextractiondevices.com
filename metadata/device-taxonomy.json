    },
    "TAX-02": {
      "severity": "error",
      "name": "flame-exclusive",
      "message": "direct-flame and indirect-flame are mutually exclusive heat-generation mechanisms"
    },
    "TAX-03": {
      "severity": "error",
      "name": "manual-vs-session",
      "message": "manual thermal cycle and session are contradictory operating modes for a single record"
    },
    "TAX-04": {
      "severity": "error",
      "name": "battery-vs-mains",
      "message": "battery and mains are mutually exclusive primary power sources unless dual power is documented"
    },
    "TAX-05": {
      "severity": "error",
      "name": "bundle-not-model",
      "message": "a bundle is a retail SKU and must never be tagged as a device model"
    }
