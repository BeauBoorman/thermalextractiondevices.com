# --- Build outputs (never commit) ---
dist/
publish/
site/
exports/

# --- Local toolchain & provisioner artifacts ---
bin/boris*
.tools/
.zig-cache/
zig-out/

# --- Dependencies ---
node_modules/

# --- Local environment & secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.pyc
*.pyo

# --- Editor / OS noise ---
.wrangler/
.DS_Store
.idea/
.vscode/
*.log
*.tmp

# California DCC raw and normalized source payloads are private/unpublished.
# Keep only the small provenance manifest, schema note, and sync reports below.
data/dcc/*
!data/dcc/manifest.json
!data/dcc/schema-report.md
!data/dcc/sync-reports/
!data/dcc/sync-reports/*.md

# Ingest working directory: large raw/normalized artifacts stay out of Git.
# Only small durable records under data/<jurisdiction>-ccc/ are committed.
var/
.tools/

# Source-health auditor state (P16): transient network cache, never committed.
data/source-health/

# Research corpus bulk files (only README.md and _index/ are committed)
research/*
!research/README.md
!research/_index/
